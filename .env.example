# =============================================================================
# GuacamoleGH Share — Configuración de Entorno
# =============================================================================

# Servidor y Entorno
NODE_ENV=production
PORT=3000

# Base de Datos SQLite (Ruta absoluta o relativa)
DB_PATH=/app/data/share.db

# Almacenamiento de Archivos y Fragmentos
STORAGE_PATH=/app/storage

# Seguridad y Autenticación
# Secreta para JWT/Cookies de sesión admin (mínimo 32 caracteres)
JWT_SECRET=cambiar_esta_clave_secreta_por_una_cadena_aleatoria_larga_y_segura

# Hash bcrypt de la contraseña de Administrador
# Para generar uno rápido en terminal: node -e "console.log(require('bcryptjs').hashSync('TuClaveAdmin', 10))"
ADMIN_PASSWORD_HASH=$2a$10$YourHashedPasswordHere

# Límites de Subida y Cuotas (en bytes)
# 2 GB por archivo por defecto (2 * 1024 * 1024 * 1024 = 2147483648)
MAX_FILE_SIZE_BYTES=2147483648

# Límite total por transferencia: 10 GB (10 * 1024 * 1024 * 1024 = 10737418240)
MAX_TRANSFER_SIZE_BYTES=10737418240

# Tamaño de cada fragmento (Chunk): 8 MB (8 * 1024 * 1024 = 8388608)
CHUNK_SIZE_BYTES=8388608

# Cloudflare Turnstile (Opcional, dejar vacío para omitir validación captcha)
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Dominio público final
PUBLIC_URL=https://share.guacamolegh.es
